# Copy this file to `.env` before connecting a real model provider.
# Do not commit your real `.env` file.

# Required when using the OpenAI API.
OPENAI_API_KEY=

# Optional: URL for a local or internal model/server endpoint.
# Examples:
# SERVER_URL=http://localhost:11434
# SERVER_URL=http://localhost:8000
SERVER_URL=

# Optional: provider/model settings for future integrations.
# Examples:
# MODEL_PROVIDER=openai
# MODEL_NAME=gpt-4.1-mini
MODEL_PROVIDER=
MODEL_NAME=

