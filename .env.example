# Copy this file to `.env` before connecting a real model provider.
# Do not commit your real `.env` file.

# Provider selection.
# Keep this as `fake` while learning the agent loop.
# Later values may include: ollama, openai, litellm, local_http.
MODEL_PROVIDER=fake

# Optional: show the full prompt sent to the configured model provider.
# This is useful for learning and debugging prompt construction.
SHOW_MODEL_PROMPT=false

# Required when using the OpenAI API.
OPENAI_API_KEY=

# Optional: URL for a local or internal model/server endpoint.
# Examples:
# SERVER_URL=http://localhost:11434
# SERVER_URL=http://localhost:8000
SERVER_URL=

# Optional: model name for future integrations.
# Examples:
# MODEL_NAME=gpt-4.1-mini
# MODEL_NAME=llama3.1
MODEL_NAME=
